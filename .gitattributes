js/** merge=ours

# Nicht ins Release-Archiv — git archive respektiert export-ignore (nc-app-tooling#21).
# Haelt Dev-/Test-/Config-Dateien aus Sign-Tree + Tarball, ohne handgepflegte
# rm-Liste; nc-release-check Check 9 (Whitelist) bleibt von selbst gruen.
# vinarium liefert keine vendor-Runtime aus (composer nur php).
/.github               export-ignore
/.claude               export-ignore
/.githooks             export-ignore
/src                   export-ignore
/tests                 export-ignore
/docs                  export-ignore
/sessions              export-ignore
/screenshots           export-ignore
/dist                  export-ignore
/vendor                export-ignore
.gitattributes         export-ignore
.gitignore             export-ignore
.nvmrc                 export-ignore
package.json           export-ignore
package-lock.json      export-ignore
composer.json          export-ignore
composer.lock          export-ignore
tsconfig.json          export-ignore
vite.config.*          export-ignore
vitest.config.*        export-ignore
webpack.config.js      export-ignore
jest.config.js         export-ignore
babel.config.js        export-ignore
.eslintrc.*            export-ignore
eslint.config.*        export-ignore
.eslintignore          export-ignore
playwright.config.*    export-ignore
phpunit.xml            export-ignore
CLAUDE.md              export-ignore
CODEOWNERS             export-ignore
# THIRD_PARTY_NOTICES.md bleibt bewusst IM Archiv: die attributierten Assets
# (img/app.svg, mdi-grapes, Apache-2.0) werden ausgeliefert, die Attribution
# muss mit. Nicht per export-ignore entfernen.
# whatsnew/ steht bewusst NICHT hier: die Datei wird ausgeliefert und ist der
# Inhalt des „Was ist neu?"-Fensters (#284). Ein export-ignore darauf laesst das
# Fenster im Release stumm bleiben. nc-app-tooling ab v1.15.0 fuehrt `whatsnew`
# in der Release-Whitelist, aeltere Fassungen weisen den Ordner als Stray ab.
