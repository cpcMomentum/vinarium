{
  "name": "vinarium",
  "version": "0.5.0",
  "description": "Private Weinkeller-Verwaltung als Nextcloud-App",
  "license": "AGPL-3.0-or-later",
  "author": "cpcMomentum",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/cpcMomentum/vinarium.git"
  },
  "bugs": {
    "url": "https://github.com/cpcMomentum/vinarium/issues"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && mkdir -p js css && cp -r dist/js/* js/ && cp -r dist/css/* css/",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "l10n:check": "nc-l10n-check",
    "l10n:fix": "nc-l10n-check --fix",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@nextcloud/axios": "^2.6.0",
    "@nextcloud/l10n": "^1.6.0",
    "@nextcloud/router": "^3.1.0",
    "@nextcloud/vue": "^9.11.0",
    "cropperjs": "^1.6.3",
    "linkifyjs": "^4.1.3",
    "pinia": "^2.3.1",
    "vue": "^3.5.13",
    "vue-cropperjs": "^5.0.0",
    "vue-material-design-icons": "^5.3.1",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@nextcloud/eslint-config": "^9.0.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.5.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.9.1",
    "happy-dom": "^20.12.0",
    "nc-app-tooling": "github:cpcMomentum/nc-app-tooling#v1.14.0",
    "sass": "^1.103.1",
    "typescript": "^5.7.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": "^22.14.0 || ^24.0.0 || >=26.0.0"
  }
}
